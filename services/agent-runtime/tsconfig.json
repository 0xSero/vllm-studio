{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext", "dom"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "effect": ["./node_modules/effect/dist/index"],
      "playwright-core": ["./node_modules/playwright-core"],
      "hono": ["./node_modules/hono"],
      "@hono/node-server": ["./node_modules/@hono/node-server"],
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-ai"],
      "@earendil-works/pi-coding-agent": [
        "./node_modules/@earendil-works/pi-coding-agent"
      ]
    }
  },
  "include": ["src/**/*.ts", "../../shared/agent/**/*.ts"]
}
