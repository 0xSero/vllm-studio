# Copy to .env, adjust as needed, then run `npm run doctor`.

# Controller API
LOCAL_STUDIO_HOST=127.0.0.1
LOCAL_STUDIO_PORT=8080

# Non-loopback binds require a key; unsafe startup is refused unless the
# trusted-LAN opt-out below is true.
LOCAL_STUDIO_API_KEY=

# LOCAL_STUDIO_ALLOW_UNAUTHENTICATED=false
# Keyless wildcard binds must list every accepted request host or IP.
# LOCAL_STUDIO_ALLOWED_HOSTS=studio.lan,192.168.1.10
# Direct browser access may allow comma-separated origins.
# LOCAL_STUDIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Privileged opt-in: permit recipe commands to execute arbitrary binaries.
# LOCAL_STUDIO_ALLOW_CUSTOM_LAUNCH_COMMAND=false
# Defaults true for models needing custom code; false is safer. Recipes override it.
# LOCAL_STUDIO_DEFAULT_TRUST_REMOTE_CODE=true

LOCAL_STUDIO_INFERENCE_PORT=8000

# Paths
# Writable model directory; startup tries to create it (default: /models).
# LOCAL_STUDIO_MODELS_DIR=/models
LOCAL_STUDIO_DATA_DIR=./data

# Only configured recipes may use /v1/chat/completions when true.
# LOCAL_STUDIO_STRICT_OPENAI_MODELS=false
