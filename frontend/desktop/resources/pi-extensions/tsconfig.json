{
  // These files are shipped as-is and loaded by pi at runtime, so they are not
  // part of desktop/tsconfig.json (which emits to desktop/dist). Without their
  // own project they were type-checked nowhere and silently rotted — 14 errors
  // had accumulated before this was added to `check:static`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./*.ts"]
}
