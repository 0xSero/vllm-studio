# Frontend Environment Variables

# Backend API URL (controller)
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080


# Optional controller API authentication
# Prefer saving this server-side via /api/settings instead of persisting it in the browser.
API_KEY=

# =============================================================================
# Frontend access control
# =============================================================================
# The frontend hosts an in-process coding agent with shell/filesystem tools, so
# reaching it grants the permissions of the host user.
#
# Production web startup requires a shared secret. Enter it on the `/access`
# page, which exchanges it through a POST body for an HttpOnly cookie. API
# clients may send the `x-local-studio-token` header. Query-string tokens are
# rejected. Desktop and development use their explicit local trust boundaries.
# Generate a token with: openssl rand -hex 32
# LOCAL_STUDIO_FRONTEND_TOKEN=

# Use only on a trusted network when unauthenticated host access is intentional.
# LOCAL_STUDIO_FRONTEND_ALLOW_UNAUTHENTICATED=false
