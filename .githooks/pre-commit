#!/bin/sh
set -eu

branch="$(git branch --show-current)"
case "$branch" in
  main|dev)
    echo "pre-commit: commits on $branch are blocked; use a work branch and PR" >&2
    exit 1
    ;;
esac

staged="$(git diff --cached --name-only)"
file_count="$(printf '%s\n' "$staged" | awk 'NF { count += 1 } END { print count + 0 }')"
line_count="$(git diff --cached --numstat | awk '
  $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 !~ /(^|\/)(package-lock\.json|bun\.lockb?|.*\.snap)$/ {
    count += $1 + $2
  }
  END { print count + 0 }
')"

if [ "$file_count" -gt 15 ] || [ "$line_count" -gt 600 ]; then
  echo "pre-commit: staged change is too large for one microcommit ($file_count files, $line_count source lines)" >&2
  echo "pre-commit: limit is 15 files and 600 source lines; split the logical changes" >&2
  exit 1
fi

if printf '%s\n' "$staged" | grep -qE '^(frontend|shared|tests/frontend)/'; then
  echo "pre-commit: frontend staged lint/format + typecheck"
  npm --prefix frontend run precommit
fi

if printf '%s\n' "$staged" | grep -q '^controller/'; then
  echo "pre-commit: controller typecheck"
  (cd controller && bun run typecheck)
fi
