{
  "name": "local-studio",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/project.mjs setup",
    "release:notes": "node scripts/project.mjs release-notes",
    "release:check-commits": "node scripts/project.mjs check-commits --range origin/main..HEAD",
    "release:stage-desktop": "node scripts/project.mjs stage-release",
    "setup:git-hooks": "node scripts/project.mjs setup-hooks",
    "dev:controller": "bun run --cwd controller dev",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:controller": "bun run --cwd controller start",
    "start": "npm --prefix frontend start",
    "check": "npm run check:automation && npm run check:contracts && npm run check:structure && npm run check:frontend && npm run check:controller && npm run check:agent-runtime",
    "check:automation": "node scripts/project.mjs audit-layout",
    "check:contracts": "node scripts/project.mjs validate-contracts",
    "check:structure": "node scripts/project.mjs validate-structure",
    "check:frontend": "npm --prefix frontend run check:quality",
    "check:controller": "cd controller && bun run typecheck && bun run lint && bun run check",
    "check:agent-runtime": "cd services/agent-runtime && bun run check",
    "dev:agent-runtime": "npm --prefix services/agent-runtime run build && node services/agent-runtime/dist/server.js",
    "desktop:build": "cd frontend && npm run desktop:build",
    "desktop:dist": "cd frontend && npm run desktop:dist",
    "desktop:pack": "cd frontend && npm run desktop:pack"
  }
}
