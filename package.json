{
  "name": "local-studio",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "doctor": "node scripts/project.mjs doctor",
    "setup": "node scripts/project.mjs setup",
    "release:notes": "node scripts/project.mjs release-notes",
    "release:check-commits": "node scripts/project.mjs check-commits --range origin/main..HEAD",
    "release:stage-desktop": "node scripts/project.mjs stage-release",
    "setup:git-hooks": "node scripts/project.mjs setup-hooks",
    "dev:controller": "bun --cwd controller run dev",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:controller": "bun --cwd controller run start",
    "start": "npm --prefix frontend start",
    "test": "npm --prefix frontend test && npm --prefix services/agent-runtime test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "check": "npm run check:automation && npm run check:workflow-pins && npm run check:contracts && npm run check:structure && npm run check:release && npm run check:frontend && npm run check:controller && npm run check:agent-runtime",
    "check:automation": "node scripts/project.mjs audit-layout",
    "check:workflow-pins": "node --test .github/workflow-policy.test.mjs && node .github/workflow-policy.mjs",
    "check:contracts": "node scripts/project.mjs validate-contracts",
    "check:structure": "node scripts/project.mjs validate-structure",
    "check:release": "node scripts/project.mjs self-test",
    "check:frontend": "npm --prefix frontend run check:quality",
    "check:controller": "cd controller && bun run typecheck && bun run lint && bun run check && bun run test",
    "check:agent-runtime": "cd services/agent-runtime && bun run check",
    "test:integration": "npm --prefix services/agent-runtime run check",
    "dev:agent-runtime": "npm --prefix services/agent-runtime run build && node services/agent-runtime/dist/server.js",
    "desktop:build": "cd frontend && npm run desktop:build",
    "desktop:dist": "cd frontend && npm run desktop:dist",
    "desktop:pack": "cd frontend && npm run desktop:pack"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "semantic-release": "25.0.9"
  }
}
