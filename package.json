{
  "name": "local-studio",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "doctor": "node scripts/project.mjs doctor",
    "setup": "bun install --frozen-lockfile && bun run setup:git-hooks",
    "release:semantic": "npx --yes --package semantic-release@24.2.7 --package @semantic-release/commit-analyzer@13.0.1 --package @semantic-release/release-notes-generator@14.1.0 --package @semantic-release/github@11.0.6 --package conventional-changelog-conventionalcommits@8.0.0 semantic-release",
    "setup:git-hooks": "node scripts/project.mjs setup-hooks",
    "dev:controller": "bun run --cwd controller dev",
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start:controller": "bun run --cwd controller start",
    "start": "bun run --cwd frontend start",
    "check": "bun run check:automation && bun run check:contracts && bun run check:structure && bun run check:frontend && bun run check:controller && bun run check:agent-runtime",
    "check:automation": "node scripts/project.mjs audit-layout",
    "check:contracts": "node scripts/project.mjs validate-contracts",
    "check:structure": "node scripts/project.mjs validate-structure",
    "check:frontend": "bun run --cwd frontend check:quality",
    "check:controller": "bun run --cwd controller typecheck && bun run --cwd controller lint && bun run --cwd controller check",
    "check:agent-runtime": "bun run --cwd services/agent-runtime check",
    "dev:agent-runtime": "bun run --cwd services/agent-runtime build && node services/agent-runtime/dist/server.js"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "controller",
    "controller/contracts",
    "frontend",
    "services/agent-runtime",
    "shared"
  ],
  "overrides": {
    "zod-validation-error": "4.0.2"
  }
}
